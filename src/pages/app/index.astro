---
import ClinicLayout from '../../layouts/ClinicLayout.astro';
import ClinicApp from '../../clinic/ClinicApp';
---

<ClinicLayout>
    {/* رسالة إقلاع تظهر فورًا وتختفي عند تشغيل التطبيق — حتى لا تكون الصفحة بيضاء إن فشل التحميل */}
    <div id="clinic-boot" class="flex min-h-screen flex-col items-center justify-center gap-3 px-6 text-center">
        <div class="flex size-12 items-center justify-center rounded-xl bg-teal-600 text-2xl text-white">✚</div>
        <p id="clinic-boot-title" class="text-sm font-bold text-slate-700">جارٍ تحميل البرنامج…</p>
        <p id="clinic-boot-hint" class="max-w-md text-xs text-slate-500"></p>
    </div>

    <ClinicApp client:only="react" />

    <noscript>
        <div class="mx-auto max-w-xl p-8 text-center">
            <h1 class="text-xl font-bold">هذا البرنامج يحتاج إلى تفعيل JavaScript</h1>
            <p class="mt-2 text-sm text-slate-600">يعمل النظام بالكامل داخل المتصفح، لذا يرجى تفعيل JavaScript ثم إعادة تحميل الصفحة.</p>
        </div>
    </noscript>
</ClinicLayout>

<script is:inline>
    // إن لم يبدأ التطبيق خلال 12 ثانية فالمشكلة في تحميل الملفات — نعرض السبب بدل شاشة بيضاء
    window.addEventListener('error', function (event) {
        var hint = document.getElementById('clinic-boot-hint');
        if (hint && !hint.textContent) hint.textContent = 'خطأ أثناء التحميل: ' + (event.message || 'تعذر تحميل ملفات البرنامج');
    }, true);

    setTimeout(function () {
        var boot = document.getElementById('clinic-boot');
        if (!boot) return;
        var title = document.getElementById('clinic-boot-title');
        var hint = document.getElementById('clinic-boot-hint');
        if (title) title.textContent = 'تعذر تشغيل البرنامج';
        if (hint && !hint.textContent) {
            hint.textContent = 'لم تُحمَّل ملفات البرنامج. جرّب إعادة تحميل الصفحة، وإن تكرر الأمر أبلغ المسؤول التقني برسالة الخطأ من Console في المتصفح.';
        }
    }, 12000);
</script>
