---
import { renderMarkdown, type WikiLinkResolver } from '../utils/markdown';

interface Props {
    content: string;
    class?: string;
    resolveWikiLink?: WikiLinkResolver;
}

const { content, class: className, resolveWikiLink } = Astro.props;

const html = await renderMarkdown(content, { resolveWikiLink });
---

<div class:list={['markdown', className]} set:html={html} />
