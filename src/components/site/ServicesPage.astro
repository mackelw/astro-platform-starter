---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getLangFromUrl, localizedPath, useTranslations } from '../../i18n/ui';
import { entriesFor } from '../../i18n/content';
import { render } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (p: string) => localizedPath(lang, p);

const services = await entriesFor('services', lang);
const rendered = await Promise.all(services.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const currency = lang === 'ar' ? 'ج.م' : 'EGP';
---

<SiteLayout title={t('services.title')}>
    <div class="mx-auto max-w-4xl px-4 py-12">
        <h1 class="text-3xl font-extrabold text-slate-900">{t('services.title')}</h1>
        <p class="mt-3 max-w-2xl leading-relaxed text-slate-600">{t('services.intro')}</p>

        <div class="mt-8 space-y-5">
            {
                rendered.map(({ entry, Content }) => (
                    <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <div class="flex items-start gap-3">
                                <span class="text-2xl" aria-hidden="true">
                                    {entry.data.icon}
                                </span>
                                <div>
                                    <h2 class="text-lg font-bold text-slate-800">{entry.data.title}</h2>
                                    <p class="mt-1 text-sm leading-relaxed text-slate-600">{entry.data.summary}</p>
                                </div>
                            </div>
                            <dl class="flex shrink-0 gap-4 text-sm">
                                <div>
                                    <dt class="text-xs font-semibold text-slate-400">{t('services.duration')}</dt>
                                    <dd class="font-bold text-slate-700">
                                        {entry.data.duration} {t('services.minutes')}
                                    </dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-semibold text-slate-400">{t('services.price')}</dt>
                                    <dd class="font-bold text-teal-700">
                                        {entry.data.price} {currency}
                                    </dd>
                                </div>
                            </dl>
                        </div>
                        <div class="mt-4 space-y-3 border-t border-slate-100 pt-4 text-sm leading-relaxed text-slate-600 [&_strong]:font-bold [&_strong]:text-slate-800">
                            <Content />
                        </div>
                    </article>
                ))
            }
        </div>

        <div class="mt-10 rounded-xl bg-teal-50 p-6 text-center">
            <a href={path('book')} class="inline-block rounded-lg bg-teal-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-teal-700">
                {t('nav.book')}
            </a>
        </div>
    </div>
</SiteLayout>
