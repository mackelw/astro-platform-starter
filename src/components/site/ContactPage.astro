---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getLangFromUrl, localizedPath, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (p: string) => localizedPath(lang, p);
---

<SiteLayout title={t('contact.title')}>
    <div class="mx-auto max-w-2xl px-4 py-12">
        <h1 class="text-3xl font-extrabold text-slate-900">{t('contact.title')}</h1>

        <dl class="mt-8 space-y-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
                <dt class="text-xs font-semibold text-slate-400">{t('contact.phone')}</dt>
                <dd class="mt-1 text-lg font-bold text-slate-800" dir="ltr" data-clinic="phone">—</dd>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
                <dt class="text-xs font-semibold text-slate-400">{t('contact.address')}</dt>
                <dd class="mt-1 font-semibold text-slate-800" data-clinic="address">—</dd>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
                <dt class="text-xs font-semibold text-slate-400">{t('contact.hours')}</dt>
                <dd class="mt-1 font-semibold text-slate-800" dir="ltr" data-clinic="hours">—</dd>
            </div>
        </dl>

        <div class="mt-8 rounded-xl bg-teal-50 p-6 text-center">
            <p class="text-sm text-teal-900">{t('contact.book')}</p>
            <a href={path('book')} class="mt-3 inline-block rounded-lg bg-teal-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-teal-700">
                {t('nav.book')}
            </a>
        </div>
    </div>
</SiteLayout>

<script>
    // بيانات التواصل تعيش في إعدادات البرنامج، فنقرأها وقت التشغيل
    // بدل تثبيتها في الصفحة وقت البناء.
    fetch('/api/public/clinic-info')
        .then((r) => (r.ok ? r.json() : null))
        .then((info) => {
            if (!info) return;
            const set = (key: string, value: string) => {
                const el = document.querySelector(`[data-clinic="${key}"]`);
                if (el && value) el.textContent = value;
            };
            set('phone', info.phone);
            set('address', info.address);
            set('hours', info.workStart && info.workEnd ? `${info.workStart} — ${info.workEnd}` : '');
        })
        .catch(() => undefined);
</script>
