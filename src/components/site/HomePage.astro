---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getLangFromUrl, localizedPath, useTranslations } from '../../i18n/ui';
import { entriesFor, slugOf } from '../../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (p: string) => localizedPath(lang, p);

const services = (await entriesFor('services', lang)).slice(0, 6);
const conditions = (await entriesFor('conditions', lang)).slice(0, 6);

const why = [
    { title: t('home.why.1.title'), body: t('home.why.1.body'), icon: '🔍' },
    { title: t('home.why.2.title'), body: t('home.why.2.body'), icon: '📈' },
    { title: t('home.why.3.title'), body: t('home.why.3.body'), icon: '🏠' }
];
---

<SiteLayout>
    <section class="border-b border-slate-200 bg-gradient-to-b from-teal-50 to-white">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
            <div class="max-w-2xl">
                <p class="text-sm font-bold text-teal-700">{t('site.tagline')}</p>
                <h1 class="mt-3 text-3xl font-extrabold leading-tight text-slate-900 sm:text-5xl">{t('home.hero.title')}</h1>
                <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">{t('home.hero.body')}</p>
                <div class="mt-7 flex flex-wrap gap-3">
                    <a href={path('book')} class="rounded-lg bg-teal-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-teal-700">
                        {t('home.hero.cta')}
                    </a>
                    <a
                        href={path('services')}
                        class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    >
                        {t('home.hero.secondary')}
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14">
        <h2 class="text-2xl font-extrabold text-slate-900">{t('home.why.title')}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {
                why.map((item) => (
                    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                        <span class="text-2xl" aria-hidden="true">
                            {item.icon}
                        </span>
                        <h3 class="mt-3 text-base font-bold text-slate-800">{item.title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.body}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="border-y border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-6xl px-4 py-14">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h2 class="text-2xl font-extrabold text-slate-900">{t('home.services.title')}</h2>
                <a href={path('services')} class="text-sm font-semibold text-teal-700 hover:underline">{t('home.services.all')} →</a>
            </div>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {
                    services.map((s) => (
                        <a
                            href={path('services')}
                            class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-teal-300 hover:shadow"
                        >
                            <span class="text-2xl" aria-hidden="true">
                                {s.data.icon}
                            </span>
                            <h3 class="mt-3 text-base font-bold text-slate-800">{s.data.title}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.data.summary}</p>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-2xl font-extrabold text-slate-900">{t('home.conditions.title')}</h2>
            <a href={path('conditions')} class="text-sm font-semibold text-teal-700 hover:underline">{t('home.conditions.all')} →</a>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {
                conditions.map((c) => (
                    <a
                        href={path(`conditions/${slugOf(c)}`)}
                        class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-teal-300 hover:shadow"
                    >
                        <h3 class="text-sm font-bold text-slate-800">{c.data.title}</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{c.data.summary}</p>
                    </a>
                ))
            }
        </div>
    </section>

    <section class="border-t border-slate-200 bg-teal-700">
        <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-12 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h2 class="text-2xl font-extrabold text-white">{t('home.exercises.title')}</h2>
                <p class="mt-2 max-w-xl text-sm leading-relaxed text-teal-50">{t('home.exercises.body')}</p>
            </div>
            <a href={path('exercises')} class="shrink-0 rounded-lg bg-white px-5 py-3 text-sm font-semibold text-teal-700 transition hover:bg-teal-50">
                {t('home.exercises.all')}
            </a>
        </div>
    </section>
</SiteLayout>
