---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getLangFromUrl, localizedPath, useTranslations } from '../../i18n/ui';
import { entriesFor, slugOf } from '../../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (p: string) => localizedPath(lang, p);
const conditions = await entriesFor('conditions', lang);
---

<SiteLayout title={t('conditions.title')}>
    <div class="mx-auto max-w-4xl px-4 py-12">
        <h1 class="text-3xl font-extrabold text-slate-900">{t('conditions.title')}</h1>
        <p class="mt-3 max-w-2xl leading-relaxed text-slate-600">{t('conditions.intro')}</p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {
                conditions.map((c) => (
                    <a
                        href={path(`conditions/${slugOf(c)}`)}
                        class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-teal-300 hover:shadow"
                    >
                        <h2 class="text-base font-bold text-slate-800">{c.data.title}</h2>
                        <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.data.summary}</p>
                        <span class="mt-3 inline-block text-sm font-semibold text-teal-700">{lang === 'ar' ? 'اقرأ المزيد' : 'Read more'} →</span>
                    </a>
                ))
            }
        </div>
    </div>
</SiteLayout>
