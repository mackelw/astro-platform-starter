---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getLangFromUrl, localizedPath, useTranslations } from '../../i18n/ui';
import { titleMap } from '../../i18n/content';

interface Props {
    entry: CollectionEntry<'conditions'>;
}

const { entry } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (p: string) => localizedPath(lang, p);
const { Content } = await render(entry);

const serviceTitles = await titleMap('services', lang);
const exerciseTitles = await titleMap('exercises', lang);

const relatedServices = entry.data.relatedServices.filter((slug) => serviceTitles.has(slug));
const relatedExercises = entry.data.relatedExercises.filter((slug) => exerciseTitles.has(slug));
---

<SiteLayout title={entry.data.title} description={entry.data.summary}>
    <div class="mx-auto max-w-3xl px-4 py-12">
        <a href={path('conditions')} class="text-sm font-semibold text-teal-700 hover:underline">← {t('conditions.title')}</a>

        <h1 class="mt-4 text-3xl font-extrabold leading-tight text-slate-900">{entry.data.title}</h1>
        <p class="mt-3 text-lg leading-relaxed text-slate-600">{entry.data.summary}</p>

        {
            entry.data.symptoms.length > 0 && (
                <section class="mt-8 rounded-xl border border-slate-200 bg-white p-5">
                    <h2 class="text-base font-bold text-slate-800">{t('conditions.symptoms')}</h2>
                    <ul class="mt-3 space-y-2">
                        {entry.data.symptoms.map((s) => (
                            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-600">
                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-teal-500" aria-hidden="true" />
                                {s}
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            entry.data.treatments.length > 0 && (
                <section class="mt-4 rounded-xl border border-teal-200 bg-teal-50 p-5">
                    <h2 class="text-base font-bold text-teal-900">{t('conditions.treatments')}</h2>
                    <ul class="mt-3 space-y-2">
                        {entry.data.treatments.map((s) => (
                            <li class="flex gap-2.5 text-sm leading-relaxed text-teal-900">
                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-teal-600" aria-hidden="true" />
                                {s}
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        <div
            class="mt-8 space-y-4 leading-relaxed text-slate-700 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-slate-900 [&_strong]:font-bold [&_strong]:text-slate-900"
        >
            <Content />
        </div>

        {
            (relatedServices.length > 0 || relatedExercises.length > 0) && (
                <div class="mt-10 grid gap-4 sm:grid-cols-2">
                    {relatedServices.length > 0 && (
                        <section class="rounded-xl border border-slate-200 bg-white p-5">
                            <h2 class="text-sm font-bold text-slate-800">{t('conditions.relatedServices')}</h2>
                            <ul class="mt-3 space-y-1.5">
                                {relatedServices.map((slug) => (
                                    <li>
                                        <a href={path('services')} class="text-sm font-semibold text-teal-700 hover:underline">
                                            {serviceTitles.get(slug)}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )}
                    {relatedExercises.length > 0 && (
                        <section class="rounded-xl border border-slate-200 bg-white p-5">
                            <h2 class="text-sm font-bold text-slate-800">{t('conditions.relatedExercises')}</h2>
                            <ul class="mt-3 space-y-1.5">
                                {relatedExercises.map((slug) => (
                                    <li>
                                        <a href={path(`exercises/${slug}`)} class="text-sm font-semibold text-teal-700 hover:underline">
                                            {exerciseTitles.get(slug)}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )}
                </div>
            )
        }

        <div class="mt-10 rounded-xl bg-slate-100 p-6 text-center">
            <a href={path('book')} class="inline-block rounded-lg bg-teal-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-teal-700">
                {t('conditions.cta')}
            </a>
        </div>
    </div>
</SiteLayout>
