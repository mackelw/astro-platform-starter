---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BookingForm from './BookingForm';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { entriesFor, slugOf } from '../../i18n/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// أسماء الخدمات تُبنى وقت البناء فلا تحتاج نداء إضافيًا من المتصفح
const services = (await entriesFor('services', lang)).map((entry) => ({ slug: slugOf(entry), title: entry.data.title }));
---

<SiteLayout title={t('book.title')}>
    <div class="mx-auto max-w-2xl px-4 py-12">
        <h1 class="text-3xl font-extrabold text-slate-900">{t('book.title')}</h1>
        <p class="mt-3 leading-relaxed text-slate-600">{t('book.intro')}</p>

        <div class="mt-8">
            <BookingForm client:load lang={lang} services={services} />
        </div>
    </div>
</SiteLayout>
