---
/* Fixed atmospherics: grid, drifting scanlines and two blurred colour pools.
   Purely decorative and pointer-transparent — drop it anywhere in a page. */
---

<div class="hud-grid" aria-hidden="true"></div>
<div class="hud-scanlines" aria-hidden="true"></div>
<div class="hud-ambient left-[36%] top-[24%] size-[28vw] bg-hud-cyan/12" aria-hidden="true"></div>
<div class="hud-ambient right-[4%] bottom-[6%] size-[22vw] bg-hud-amber/8" aria-hidden="true"></div>
