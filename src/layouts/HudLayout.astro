---
import '../styles/globals.css';
import '@fontsource/chakra-petch/400.css';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import chakraWoff2 from '@fontsource/chakra-petch/files/chakra-petch-latin-400-normal.woff2?url';
import monoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import HudBackdrop from '../components/jarvis/HudBackdrop.astro';

interface Props {
    title: string;
    /** Set false to drop the scanlines, grid and ambient glow. */
    backdrop?: boolean;
}

const { title, backdrop = true } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={chakraWoff2} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={monoWoff2} crossorigin />
    </head>
    <body class="min-h-screen hud-surface hud-scroll">
        {backdrop && <HudBackdrop />}
        <div class="relative z-1"><slot /></div>
    </body>
</html>
