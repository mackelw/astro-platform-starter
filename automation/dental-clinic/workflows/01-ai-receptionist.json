            },
            "id": "wh-inbound",
            "name": "Inbound Message",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [-360, 0],
            "webhookId": "b1f4c0de-0001-4a00-9000-clinicinbound"
