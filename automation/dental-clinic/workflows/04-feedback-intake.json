                "jsonBody": "={\n  \"p_phone\": \"{{ $('Normalize Message').item.json.phone }}\",\n  \"p_rating\": {{ $json.output.rating }},\n  \"p_sentiment\": \"{{ $json.output.sentiment }}\",\n  \"p_summary\": {{ JSON.stringify($json.output.summary) }},\n  \"p_topics\": {{ JSON.stringify($json.output.topics) }},\n  \"p_raw_message\": {{ JSON.stringify($('Normalize Message').item.json.text) }},\n  \"p_is_complaint\": {{ $json.output.is_complaint }}\n}"
            },
