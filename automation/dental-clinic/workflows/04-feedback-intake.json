                "responseBody": "={{ JSON.stringify({ phone: $('Normalize Message').first().json.phone, reply: $('Classify Reply').first().json.output.is_complaint ? 'شكرًا إنك قلتلنا. سجّلنا ملاحظتك والإدارة هتتواصل معاك قريب 🙏' : 'شكرًا لوقتك ورأيك، ده بيساعدنا نتحسّن 🌟' }) }}",
