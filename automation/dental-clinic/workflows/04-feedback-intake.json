                "sendTo": "clinic-manager@your-clinic.com",
                "subject": "=🔴 شكوى من متابعة ما بعد الزيارة — {{ $('Classify Reply').item.json.output.summary }}",
                "emailType": "text",
                "message": "=تقييم: {{ $('Classify Reply').item.json.output.rating }}/5\nالانطباع: {{ $('Classify Reply').item.json.output.sentiment }}\nالمحاور: {{ $('Classify Reply').item.json.output.topics.join('، ') }}\nتليفون المريض: {{ $('Normalize Message').item.json.phone }}\n\nنص الرد:\n{{ $('Normalize Message').item.json.text }}\n\nالشكوى اتسجّلت في Supabase تحت جدول complaints.",
                "options": {}
