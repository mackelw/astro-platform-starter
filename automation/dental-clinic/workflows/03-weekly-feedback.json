            "id": "http-pending",
            "name": "Visits To Follow Up",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [-220, 0],
            "credentials": {
                "supabaseApi": {
                    "id": "REPLACE_SUPABASE_CRED_ID",
                    "name": "Supabase — clinic"
                }
