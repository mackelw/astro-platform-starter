        {
            "parameters": {
                "jsCode": "// Flatten the embedded PostgREST response into the fields the\n// Google Calendar node needs.\n\nreturn $input.all().map((item) => {\n  const a = item.json;\n  const patient = a.patients ?? {};\n  const doctor = a.doctors ?? {};\n  const service = a.services ?? {};\n\n  return {\n    json: {\n      appointment_id: a.id,\n      google_event_id: a.google_event_id,\n      calendar_id: doctor.calendar_id,\n      starts_at: a.starts_at,\n      ends_at: a.ends_at,\n      summary: `${service.name_ar} — ${patient.full_name ?? 'مريض'}`,\n      description: [\n        `الخدمة: ${service.name_ar ?? ''}`,\n        `الدكتور: ${doctor.full_name_ar ?? ''}`,\n        `المريض: ${patient.full_name ?? ''}`,\n        `تليفون: ${patient.phone ?? ''}`,\n        a.notes ? `ملاحظات: ${a.notes}` : null,\n        `Appointment ID: ${a.id}`,\n      ]\n        .filter(Boolean)\n        .join('\\n'),\n    },\n  };\n});\n"
            },
