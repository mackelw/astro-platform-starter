        {
            "parameters": {
                "jsCode": "// Supabase database webhooks post { type, table, record, old_record }.\n// Translate the row change into one calendar action.\n\nconst payload = $input.first().json.body ?? $input.first().json;\nconst record = payload.record ?? payload;\nconst previous = payload.old_record ?? {};\n\nconst status = record.status;\nconst eventId = record.google_event_id;\n\nlet action = 'none';\n\nif (status === 'booked' && !eventId) {\n  action = 'create';\n} else if (status === 'booked' && eventId) {\n  const moved =\n    previous.starts_at !== record.starts_at || previous.ends_at !== record.ends_at;\n  action = moved ? 'update' : 'none';\n} else if (status === 'cancelled' && eventId) {\n  action = 'delete';\n}\n\nreturn [\n  {\n    json: {\n      sync_action: action,\n      appointment_id: record.id,\n      google_event_id: eventId ?? null,\n    },\n  },\n];\n"
            },
            "id": "code-decide",
            "name": "Decide Action",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [-340, 40]
