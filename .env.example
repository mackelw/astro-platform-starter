# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Twilio ---
# From the Twilio Console. The auth token is also what Twilio signs webhooks with.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The number the agent answers on and calls out from, E.164 format.
TWILIO_PHONE_NUMBER=+18005551212

# --- Phone agent ---
# Shared secret required to place an outbound call via POST /api/voice/call.
# Generate one with: openssl rand -hex 32
VOICE_API_TOKEN=

# Optional. Set when the forwarded host headers can't be trusted, e.g. behind an
# extra proxy. Must be the exact public origin Twilio requests, no trailing slash.
# VOICE_PUBLIC_BASE_URL=https://your-site.netlify.app

# Optional overrides — defaults shown.
# Which Claude model answers the phone. Haiku is the default: short spoken turns
# rarely need more, and its speed is what keeps callers from waiting on silence.
# Larger models cost significantly more per call and add latency — try one only if
# your calls involve real negotiation or complex reasoning.
# Known values: claude-haiku-4-5, claude-sonnet-5, claude-opus-4-8, claude-opus-5
# VOICE_MODEL=claude-haiku-4-5
# Language Twilio transcribes the caller's speech with.
# VOICE_STT_LANGUAGE=ar-EG
# Twilio/Polly voice used to speak replies. Must match your language.
# VOICE_TTS_VOICE=Polly.Hala-Neural
# VOICE_GREETING=أهلاً بيك، معاك المساعد الآلي. اتفضل، أقدر أساعدك في إيه؟
# Full replacement for the agent's persona and rules.
# VOICE_SYSTEM_PROMPT=
# Seconds-scale budget for one reply. Must stay well under Twilio's 15s webhook timeout.
# VOICE_REPLY_TIMEOUT_MS=9000
# Turns kept before the oldest are dropped from the model's context.
# VOICE_MAX_TURNS=40

# Set to false ONLY for local testing where requests don't come from Twilio.
# Never set this in a deployed environment — it makes the webhooks fully public.
# VOICE_VALIDATE_SIGNATURE=true
