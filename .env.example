# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# Text-to-speech via /api/speak. Without ELEVENLABS_API_KEY the endpoint
# returns 503 and callers should fall back to browser speech synthesis.
#
# In production, set these in the Netlify UI (Site configuration →
# Environment variables) rather than in a committed file.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5
