        "@types/react": "^18.2.79",
        "@types/react-dom": "^18.2.25",
        "astro": "^5.5.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^4.0.14",
        "drizzle-orm": "^0.36.4"
    },
    "devDependencies": {
        "@types/node": "^20.12.7",
